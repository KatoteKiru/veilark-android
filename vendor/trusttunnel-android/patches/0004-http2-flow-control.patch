+void Http2Upstream::report_write_credit(uint32_t stream_id) {
+    if (m_closed || m_closing || !m_session || !m_socket) {
+        return;
+    }
+
+    // The callback can close connections or request a new session. Never retain
+    // an unordered_map iterator/reference across a downstream callback.
+    std::vector<std::pair<uint64_t, uint32_t>> connections;
+    connections.reserve(m_tcp_connections.size());
+    for (const auto &[id, conn] : m_tcp_connections) {
+        if (stream_id == 0 || conn.stream_id == stream_id) {
+            connections.emplace_back(id, conn.stream_id);
+        }
+    }
+    for (const auto &[id, expected_stream] : connections) {
+        if (m_closed || m_closing || !m_session || !m_socket) {
+            return;
+        }
+        auto i = m_tcp_connections.find(id);
+        if (i == m_tcp_connections.end() || i->second.stream_id != expected_stream
+                || i->second.flags.test(TcpConnection::TCF_STREAM_CLOSED)
+                || i->second.flags.test(TcpConnection::TCF_CLIENT_CLOSED) || available_to_send(id) == 0) {
+            continue;
+        }
+        ServerDataSentEvent event = {id, 0};
+        handler.func(handler.arg, SERVER_EVENT_DATA_SENT, &event);
+    }
+
+    if (!m_closed && !m_closing && m_session && m_socket && m_socket_write_flushed) {
+        auto udp_stream = m_udp_mux.get_stream_id();
+        if (udp_stream.has_value() && (stream_id == 0 || stream_id == udp_stream.value())
+                && tcp_socket_available_to_write(m_socket.get()) > 0
+                && http_session_available_to_write(m_session.get(), (int32_t) udp_stream.value()) > 0) {
+            m_udp_mux.report_sent_bytes(true);
+        }
+    }
+}
