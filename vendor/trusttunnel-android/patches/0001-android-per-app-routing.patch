+    private fun applyApplicationRouting(builder: Builder) {
+        val preferences = applicationContext.getSharedPreferences(
+            ApplicationRoutingPolicy.PREFERENCES_NAME,
+            Context.MODE_PRIVATE,
+        )
+        val modePreference = preferences.getString(ApplicationRoutingPolicy.MODE_KEY, null)
+        val selectedPackages = preferences
+            .getStringSet(ApplicationRoutingPolicy.PACKAGES_KEY, emptySet())
+            ?.toSet()
+            .orEmpty()
+        val plan = ApplicationRoutingPolicy.create(
+            modePreference = modePreference,
+            selectedPackages = selectedPackages,
+            ownPackage = applicationContext.packageName,
+        )
+        val appliedRules = applyApplicationRoutingPlan(plan, BuilderApplicationRuleSink(builder))
+        LOG.info("Applied application routing mode=${plan.mode.preferenceValue}, rules=$appliedRules")
+    }
+
+    private inner class BuilderApplicationRuleSink(
+        private val builder: Builder,
+    ) : ApplicationRuleSink {
+        override fun allow(packageName: String): Boolean = applyPackageRule(packageName) {
+            builder.addAllowedApplication(packageName)
+        }
+
+        override fun disallow(packageName: String): Boolean = applyPackageRule(packageName) {
+            builder.addDisallowedApplication(packageName)
+        }
+
+        private fun applyPackageRule(packageName: String, rule: () -> Unit): Boolean = try {
+            rule()
+            true
+        } catch (_: PackageManager.NameNotFoundException) {
+            LOG.warn("Ignoring application routing rule for an uninstalled package: $packageName")
+            false
+        }
+    }
+
