+package com.adguard.trusttunnel
+
+internal enum class ApplicationRoutingMode(val preferenceValue: String) {
+    ALL("all"),
+    ONLY("only"),
+    BYPASS("bypass");
+
+    companion object {
+        fun fromPreference(value: String?): ApplicationRoutingMode =
+            entries.firstOrNull { it.preferenceValue == value } ?: ALL
+    }
+}
+
+internal data class ApplicationRoutingPlan(
+    val mode: ApplicationRoutingMode,
+    val packages: List<String>,
+)
+
+internal object ApplicationRoutingPolicy {
+    const val PREFERENCES_NAME = "profile_meta"
+    const val MODE_KEY = "application_mode"
+    const val PACKAGES_KEY = "selected_applications"
+
+    fun create(
+        modePreference: String?,
+        selectedPackages: Set<String>,
+        ownPackage: String,
+    ): ApplicationRoutingPlan {
+        val mode = ApplicationRoutingMode.fromPreference(modePreference)
+        val normalizedPackages = selectedPackages
+            .asSequence()
+            .map(String::trim)
+            .filter(String::isNotEmpty)
+            .distinct()
+            .sorted()
+            .toList()
+
+        val packages = when (mode) {
+            ApplicationRoutingMode.ALL -> listOf(ownPackage)
+            ApplicationRoutingMode.ONLY -> normalizedPackages.filterNot { it == ownPackage }
+            ApplicationRoutingMode.BYPASS -> (normalizedPackages + ownPackage).distinct().sorted()
+        }
+        return ApplicationRoutingPlan(mode, packages)
+    }
+}
+
+internal interface ApplicationRuleSink {
+    /** Returns false when the package is no longer installed. */
+    fun allow(packageName: String): Boolean
+
+    /** Returns false when the package is no longer installed. */
+    fun disallow(packageName: String): Boolean
+}
+
+internal fun applyApplicationRoutingPlan(
+    plan: ApplicationRoutingPlan,
+    sink: ApplicationRuleSink,
+): Int {
+    var appliedRules = 0
+    plan.packages.forEach { packageName ->
+        val applied = when (plan.mode) {
+            ApplicationRoutingMode.ONLY -> sink.allow(packageName)
+            ApplicationRoutingMode.ALL,
+            ApplicationRoutingMode.BYPASS,
+            -> sink.disallow(packageName)
+        }
+        if (applied) {
+            appliedRules += 1
+        }
+    }
+
+    check(plan.mode != ApplicationRoutingMode.ONLY || appliedRules > 0) {
+        "No selected applications are installed; refusing to create an unrestricted VPN"
+    }
+    return appliedRules
+}
