--- /dev/null
+++ b/platform/android/lib/src/test/java/com/adguard/trusttunnel/ApplicationRoutingTest.kt
@@ -0,0 +1,115 @@
+package com.adguard.trusttunnel
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertThrows
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class ApplicationRoutingTest {
+    @Test
+    fun allDisallowsOnlyOwnPackage() {
+        val plan = ApplicationRoutingPolicy.create("all", setOf("app.one"), OWN_PACKAGE)
+
+        assertEquals(ApplicationRoutingMode.ALL, plan.mode)
+        assertEquals(listOf(OWN_PACKAGE), plan.packages)
+        assertUsesOnlyDisallowedRules(plan)
+    }
+
+    @Test
+    fun bypassDisallowsSelectedPackagesAndOwnPackage() {
+        val plan = ApplicationRoutingPolicy.create(
+            "bypass",
+            setOf("app.two", OWN_PACKAGE, "app.one"),
+            OWN_PACKAGE,
+        )
+
+        assertEquals(ApplicationRoutingMode.BYPASS, plan.mode)
+        assertEquals(listOf("app.one", "app.two", OWN_PACKAGE).sorted(), plan.packages)
+        assertUsesOnlyDisallowedRules(plan)
+    }
+
+    @Test
+    fun onlyAllowsSelectedPackagesWithoutOwnPackage() {
+        val plan = ApplicationRoutingPolicy.create(
+            "only",
+            setOf("app.two", OWN_PACKAGE, "app.one"),
+            OWN_PACKAGE,
+        )
+
+        assertEquals(ApplicationRoutingMode.ONLY, plan.mode)
+        assertEquals(listOf("app.one", "app.two"), plan.packages)
+        val sink = RecordingSink()
+        applyApplicationRoutingPlan(plan, sink)
+        assertEquals(plan.packages, sink.allowed)
+        assertTrue(sink.disallowed.isEmpty())
+    }
+
+    @Test
+    fun unknownModeFallsBackToSafeAllMode() {
+        val plan = ApplicationRoutingPolicy.create("unexpected", setOf("app.one"), OWN_PACKAGE)
+
+        assertEquals(ApplicationRoutingMode.ALL, plan.mode)
+        assertEquals(listOf(OWN_PACKAGE), plan.packages)
+    }
+
+    @Test
+    fun stalePackagesAreIgnoredInBypassMode() {
+        val plan = ApplicationRoutingPolicy.create(
+            "bypass",
+            setOf("app.installed", "app.removed"),
+            OWN_PACKAGE,
+        )
+        val sink = RecordingSink(stalePackages = setOf("app.removed"))
+
+        val applied = applyApplicationRoutingPlan(plan, sink)
+
+        assertEquals(2, applied)
+        assertFalse("app.removed" in sink.disallowed)
+        assertTrue("app.installed" in sink.disallowed)
+        assertTrue(OWN_PACKAGE in sink.disallowed)
+        assertTrue(sink.allowed.isEmpty())
+    }
+
+    @Test
+    fun onlyModeFailsClosedWhenEverySelectedPackageIsStale() {
+        val plan = ApplicationRoutingPolicy.create("only", setOf("app.removed"), OWN_PACKAGE)
+        val sink = RecordingSink(stalePackages = setOf("app.removed"))
+
+        assertThrows(IllegalStateException::class.java) {
+            applyApplicationRoutingPlan(plan, sink)
+        }
+        assertTrue(sink.allowed.isEmpty())
+        assertTrue(sink.disallowed.isEmpty())
+    }
+
+    private fun assertUsesOnlyDisallowedRules(plan: ApplicationRoutingPlan) {
+        val sink = RecordingSink()
+        applyApplicationRoutingPlan(plan, sink)
+        assertEquals(plan.packages, sink.disallowed)
+        assertTrue(sink.allowed.isEmpty())
+    }
+
+    private class RecordingSink(
+        private val stalePackages: Set<String> = emptySet(),
+    ) : ApplicationRuleSink {
+        val allowed = mutableListOf<String>()
+        val disallowed = mutableListOf<String>()
+
+        override fun allow(packageName: String): Boolean {
+            if (packageName in stalePackages) return false
+            allowed += packageName
+            return true
+        }
+
+        override fun disallow(packageName: String): Boolean {
+            if (packageName in stalePackages) return false
+            disallowed += packageName
+            return true
+        }
+    }
+
+    companion object {
+        private const val OWN_PACKAGE = "app.veilark.test"
+    }
+}
