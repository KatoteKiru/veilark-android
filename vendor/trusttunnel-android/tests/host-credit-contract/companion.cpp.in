struct ServerHandler { void (*func)(void*,int,void*); void *arg; };
struct Http2Upstream;
struct HttpUdpMultiplexer {
    enum { MS_IDLE, MS_ESTABLISHED };
    struct Conn { size_t sent_bytes_since_flush=0; };
    int m_state=MS_ESTABLISHED; uint32_t m_stream_id=5;
    std::unordered_map<uint64_t,Conn> m_connections;
    struct { Http2Upstream *parent; } m_params;
    std::optional<uint64_t> get_stream_id() const;
    bool check_connection(uint64_t id) const { return m_connections.find(id)!=m_connections.end(); }
    void report_sent_bytes(bool notify_writable=false);
};
struct Http2Upstream {
    struct TcpConnection {
        enum { TCF_READ_ENABLED, TCF_STREAM_CLOSED, TCF_CLIENT_CLOSED };
