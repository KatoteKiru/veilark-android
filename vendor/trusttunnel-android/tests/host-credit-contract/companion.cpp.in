    std::array<size_t,3> remaining{65535,0,0};
    static ssize_t discard(nghttp2_session*,const uint8_t*,size_t n,int,void*) { return n; }
    static ssize_t bounded(nghttp2_session*,int32_t,uint8_t *buf,size_t n,uint32_t*,nghttp2_data_source *s,void*) {
        auto *remaining=static_cast<size_t*>(s->ptr);
        if(!*remaining) return NGHTTP2_ERR_DEFERRED;
        n=std::min(n,*remaining);std::memset(buf,0,n);*remaining-=n;return n;
    }
    static void credit(void *p,int,void *data) {
        auto *e=static_cast<Env*>(p);auto v=*static_cast<HttpDataSentEvent*>(data);
        e->credits.push_back(v);e->core.report_write_credit(static_cast<uint32_t>(v.stream_id));
    }
    static void sink(void *p,int,void *data) {
        auto *e=static_cast<Env*>(p);auto v=*static_cast<ServerDataSentEvent*>(data);
        e->sent.push_back(v);if(e->downstream)e->downstream(v);
    }
    Env() {
        core.m_session=std::make_shared<HttpSession>();core.m_session->h2=&h2;
        core.m_session->params.handler={credit,this};core.handler={sink,this};core.m_udp_mux.m_params.parent=&core;
        nghttp2_session_callbacks *cb=nullptr;assert(nghttp2_session_callbacks_new(&cb)==0);
        nghttp2_session_callbacks_set_send_callback(cb,discard);nghttp2_session_callbacks_set_on_frame_recv_callback(cb,on_credit_frame);
        assert(nghttp2_session_client_new(&native,cb,core.m_session.get())==0);nghttp2_session_callbacks_del(cb);h2.ngsession=native;
        assert(nghttp2_submit_settings(native,0,nullptr,0)==0);assert(nghttp2_session_send(native)==0);
        settings(1048576);credits.clear();sent.clear();
        for(int i=0;i<3;++i) {
            uint8_t method[] = ":method",connect[]="CONNECT",authority[]=":authority",target[]="unit.example.test:443";
            nghttp2_nv hdr[]={{method,connect,sizeof(method)-1,sizeof(connect)-1,0},{authority,target,sizeof(authority)-1,sizeof(target)-1,0}};
            nghttp2_data_provider provider{};provider.source.ptr=&remaining[i];provider.read_callback=bounded;
            assert(nghttp2_submit_request(native,nullptr,hdr,2,&provider,nullptr)==2*i+1);
        }
        assert(nghttp2_session_send(native)==0);assert(remaining[0]==0);
        assert(nghttp2_session_get_remote_window_size(native)==0);
        core.m_tcp_connections.emplace(101,Http2Upstream::TcpConnection{1,{}});
        core.m_tcp_connections.emplace(102,Http2Upstream::TcpConnection{3,{}});
    }
    ~Env(){nghttp2_session_del(native);}
    void recv(const uint8_t *p,size_t n){assert(nghttp2_session_mem_recv(native,p,n)==static_cast<ssize_t>(n));}
    void settings(uint32_t n) {
        std::array<uint8_t,15> f{0,0,6,NGHTTP2_SETTINGS,0,0,0,0,0,0,4,uint8_t(n>>24),uint8_t(n>>16),uint8_t(n>>8),uint8_t(n)};recv(f.data(),f.size());
    }
    void ack(){std::array<uint8_t,9> f{0,0,0,NGHTTP2_SETTINGS,NGHTTP2_FLAG_ACK,0,0,0,0};recv(f.data(),f.size());}
    void window(uint32_t stream,uint32_t n) {
        std::array<uint8_t,13> f{0,0,4,NGHTTP2_WINDOW_UPDATE,0,uint8_t(stream>>24),uint8_t(stream>>16),uint8_t(stream>>8),uint8_t(stream),uint8_t(n>>24),uint8_t(n>>16),uint8_t(n>>8),uint8_t(n)};recv(f.data(),f.size());
    }
    void credit_ready(){window(0,4096);credits.clear();sent.clear();}
};
