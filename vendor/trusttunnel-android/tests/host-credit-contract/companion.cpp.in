    std::unordered_map<uint64_t,TcpConnection> m_tcp_connections;
    HttpUdpMultiplexer m_udp_mux;
    ServerHandler handler;
    void report_write_credit(uint32_t stream_id);
    size_t available_to_send(uint64_t id);
    std::optional<uint32_t> get_stream_id(uint64_t id) const;
};
