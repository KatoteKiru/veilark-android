* text=auto
*.bat text eol=crlf
*.ps1 text eol=crlf
*.sh text eol=lf
*.kt text eol=lf
*.kts text eol=lf
*.xml text eol=lf
*.md text eol=lf
*.aar binary
vendor/trusttunnel-android/patches/*.patch text eol=lf
*.png binary
*.webp binary
